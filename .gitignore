# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# …except the Gradle wrapper, which is committed on purpose: it is what lets a fresh checkout and
# CI build this project without Gradle installed, and it is excluded by the *.jar rule above.
!gradle/wrapper/gradle-wrapper.jar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# Kotlin Gradle plugin data, see https://kotlinlang.org/docs/whatsnew20.html#new-directory-for-kotlin-data-in-gradle-projects
.kotlin/

# Gradle
.gradle/
build/
!gradle/wrapper/
local.properties

# IDEs
.idea/
*.iml
*.ipr
*.iws
.vscode/

# macOS
.DS_Store

# Test vectors fetched by scripts/ — large, pinned upstream, never committed here.
src/test/resources/vectors/acvp/
