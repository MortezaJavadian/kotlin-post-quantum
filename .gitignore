# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# …except the Gradle wrapper, which is committed on purpose: it is what lets a fresh checkout and
# CI build this project without Gradle installed, and it is excluded by the *.jar rule above.
!gradle/wrapper/gradle-wrapper.jar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# Kotlin Gradle plugin data, see https://kotlinlang.org/docs/whatsnew20.html#new-directory-for-kotlin-data-in-gradle-projects
.kotlin/

# Gradle
.gradle/
build/
!gradle/wrapper/
local.properties

# IDEs
.idea/
*.iml
*.ipr
*.iws
.vscode/

# macOS
.DS_Store

# Test vectors, fetched by scripts/fetch-vectors.sh from pinned upstream commits — 63 MB of
# gzipped ACVP and Wycheproof JSON. Deliberately not committed: they are large, they are not this
# project's to redistribute, and a checked-in copy is a copy that can be edited until it agrees with
# the implementation. Re-fetching from the pin is what makes the run reproducible.
test-vectors/
